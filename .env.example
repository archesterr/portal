# ===== required =====
# openssl rand -hex 32
SECRET_KEY=change-me
# password for /admin
ADMIN_PASSWORD=change-me-too
# 3x-ui subscription base; subId is appended
SUB_BASE_URL=https://sub.example.com:2096/sub

# ===== shop =====
BRAND_NAME=فروشگاه
# your Telegram username (the only contact shown on the site)
SUPPORT_TELEGRAM=your_id
# toman per KG
PRICE_PER_GB=800000
MIN_GB=1
MAX_GB=200
GB_PRESETS=1,2,5,10,20,50

# ===== what a purchase creates on the panel =====
# inbound IDs (one is best: 3x-ui counts traffic per inbound)
INBOUND_IDS=1
# 0 = volume only, no expiry
SERVICE_DAYS=0
# max simultaneous devices, 0 = unlimited
IP_LIMIT=0
# panel client email = <prefix><uid>-<orderid>-<inbound>
CLIENT_EMAIL_PREFIX=u

# ===== 3x-ui panel (URL includes webBasePath) =====
XUI_URL=https://127.0.0.1:2053/yourWebBasePath
XUI_USERNAME=admin
XUI_PASSWORD=secret
XUI_TOTP_SECRET=
XUI_VERIFY_TLS=true

# ===== misc =====
COOKIE_SECURE=true
# optional: Telegram alert to you on every new receipt
TG_BOT_TOKEN=
TG_ADMIN_CHAT_ID=

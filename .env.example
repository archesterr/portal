# ===== required =====
# openssl rand -hex 32
SECRET_KEY=change-me
# comma-separated; these numbers get /admin
ADMIN_PHONES=09121234567
# 3x-ui subscription base; subId is appended
SUB_BASE_URL=https://sub.example.com:2096/sub

# ===== 3x-ui panel (URL includes webBasePath) =====
XUI_URL=https://panel.example.com:2053/yourWebBasePath
XUI_USERNAME=admin
XUI_PASSWORD=secret
# set only if panel 2FA is enabled
XUI_TOTP_SECRET=
XUI_VERIFY_TLS=true

# ===== SMS: console (code printed to logs, dev only) | kavenegar =====
SMS_PROVIDER=console
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=

# ===== behaviour =====
BRAND_NAME=پرتال
SUPPORT_CONTACT=@your_support
# true = provision instantly once identity is approved
AUTO_APPROVE_REQUESTS=false
# plan days start counting on first connection
START_ON_FIRST_USE=true
MAX_ACTIVE_PER_USER=1
# delete ID/selfie images right after you approve/reject
KYC_PURGE_AFTER_REVIEW=true
# panel client email = <prefix><uid>-<reqid>-<inbound>
CLIENT_EMAIL_PREFIX=p
# false only for plain-http local testing
COOKIE_SECURE=true

# ===== optional admin alerts =====
TG_BOT_TOKEN=
TG_ADMIN_CHAT_ID=
